# --- Zabon Blog App Specific ---
# NOTE: repo root IS zabon/, so patterns are relative to it: use
# apps/zabon-blog/…, NOT zabon/apps/zabon-blog/… (the latter matched nothing).
apps/zabon-blog/node_modules/
apps/zabon-blog/.env
apps/zabon-blog/tools/reports/*.json
apps/zabon-blog/PARTIAL.md
apps/zabon-blog/notes/

# ---------- Continue extension config (may contain secrets) ----------
# config.yaml is kept on disk but NOT committed: it can hold the
# OpenRouter API key. Do not inline a key into a tracked file again
# (the bcd0812 leak). See notes/continue-config-cleanup.md.
.continue/config.yaml
.continue/.env

# ---------- OS files ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------- Editor / IDE ----------
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ---------- Node / build tooling (if added later) ----------
node_modules/
dist/
build/
.cache/
.parcel-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.env
.env.*
!.env.example

# ---------- Logs / temp ----------
*.log
*.tmp
*.bak
tmp/
temp/

# ---------- Misc junk (e.g. stray 0-byte files from root-level globs) ----------
# A non-UTF-8 filename breaks the GitHub Pages Jekyll build with
# "invalid byte sequence in UTF-8". The pre-commit guard
# (tools/check-utf8-paths.sh) blocks committing them; this catches the
# obvious 0-byte stray before it is ever staged.
# (Patterns are for clarity, not a substitute for the guard.)
*.crdownload
*.part

# ---------- Local archives / backups ----------
*.zip
*.tar.gz
*.7z
_backup/